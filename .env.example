# .env - QQ bridge runtime config (rebuild 2026-11-06)
# LLM_API_KEY is a placeholder: paste the real relay key on the server
# terminal (never in chat). All other values are the verified rebuild values.

# Model backend: Ly Relay, x-deepseek-v4.1-flash
LLM_BASE_URL=https://ly.77625.xyz/v1
LLM_MODEL=x-deepseek-v4.1-flash
LLM_API_KEY=<redacted>

# QQ
OWNER_QQ=1323841589
BLACKLIST_QQ_IDS=2482076278,428762607
MAID_QQ=2716043774
SELF_QQ=2750579528
# Bridge reaches NapCat by service name inside the Docker network.
NAPCAT_URL=http://napcat:3000
BRIDGE_PORT=8787

# Group silence 0:00-10:00 Beijing, private chat unaffected
QUIET_START_HOUR=0
QUIET_END_HOUR=0
# Group replies only when @-mentioned
GROUP_FREEFORM=false

# History
HISTORY_TURNS=10

# Voice (edge-tts; Genie switch is phase 2)
TTS_VOICE=zh-CN-XiaoyiNeural
TTS_VOICE_MOM=zh-CN-XiaoxuanNeural
GENIE_URL=http://genie:8000

# Stickers
STICKER_GAP_S=60
