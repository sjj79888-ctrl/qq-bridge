# .env - QQ bridge runtime config (SnowLuma 2026-11-07)
# LLM_API_KEY is a placeholder: paste the real relay key on the server
# terminal (never in chat). All other values are the verified values.
# QQ protocol end is SnowLuma since 2026-11-07 (was NapCat, kept stopped as rollback).

# Model backend: Ly Relay, x-deepseek-v4.1-flash
LLM_BASE_URL=https://ly.77625.xyz/v1
LLM_MODEL=x-deepseek-v4.1-flash
LLM_API_KEY=<redacted>

# QQ
OWNER_QQ=1323841589
BLACKLIST_QQ_IDS=2482076278,428762607
MAID_QQ=2716043774
SELF_QQ=2750579528
# Bridge reaches SnowLuma by service name inside the Docker network.
# (Key is still named NAPCAT_URL because bridge.py reads that name.)
NAPCAT_URL=http://snowluma:3000
BRIDGE_PORT=8787

# Group silence DISABLED (2026-11-07 00:12: QUIET_START_HOUR=0, QUIET_END_HOUR=0,
# replies around the clock); private chat unaffected
QUIET_START_HOUR=0
QUIET_END_HOUR=0
# Group replies only when @-mentioned
GROUP_FREEFORM=false

# History
HISTORY_TURNS=10

# Voice (edge-tts; Genie switch is phase 2)
TTS_VOICE=zh-CN-XiaoyiNeural
TTS_VOICE_MOM=zh-CN-XiaoxuanNeural
GENIE_URL=http://genie:8000

# Stickers
STICKER_GAP_S=60

# SparkTTS 克隆音色 (2026-11-08 Torres 批准)：小满人格、短回复（<=10 字）先试
# 这个声音，失败/超时自动回落 edge-tts；妈妈模式永远 edge-tts。
# URL 是 Muse VM 上 localhost.run 隧道的地址，随机分配、重连会变：
# 隧道重连后要把 SPARKTTS_URL 改成 tunnel_url.txt 里的新地址，否则永远回落 edge-tts。
# Token 是 Muse VM 上 service/token.txt 里的值——只填在服务器 .env，绝不进仓库。
SPARKTTS_URL=https://a2daf716e566a0.lhr.life
SPARKTTS_TOKEN=<paste-real-token-on-server>
